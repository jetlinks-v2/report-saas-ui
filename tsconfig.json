{
  "extends": "../../jetlinks-web-core/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vite/client"
    ],
    "typeRoots": [
      "../../jetlinks-web-core/node_modules/@types",
      "../../node_modules/@types",
      "../../node_modules"
    ],
    "paths": {
      "@property-base-ui/*": [
        "modules/property-base-ui/*"
      ],
      "@jetlinks-web-core/*": [
        "jetlinks-web-core/src/*"
      ],
      "@/*": [
        "jetlinks-web-core/src/*"
      ],
      "@theme-config": [
        "configs/theme/index.ts",
        "jetlinks-web-core/configs/theme/index.ts"
      ]
    },
    "baseUrl": "../.."
  },
  "include": [
    "./**/*.ts",
    "./**/*.vue",
    "../../jetlinks-web-core/src/env.d.ts",
    "../../jetlinks-web-core/src/auto-imports.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "employee-h5"
  ]
}
